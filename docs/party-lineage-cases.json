    { "case": "LJP family (the old id no longer contests)", "party": "RLJP", "date": "2025-11-14", "state": 5, "expect": { "root": "LJP", "members": ["LJPRV", "RLJP"] } },
    { "case": "no family before the split", "party": "SHS", "date": "2019-10-24", "state": 20, "expect": { "root": "SHS", "members": ["SHS"] } }
  ],
