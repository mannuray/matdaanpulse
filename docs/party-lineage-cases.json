  "relation": [
    { "case": "rename: BRS is TRS", "prev": "TRS", "cur": "BRS", "from": "2018-12-11", "to": "2023-12-03", "state": 32, "expect": "same" },
    { "case": "merger before the later election: JVM's seat now BJP", "prev": "JVM", "cur": "BJP", "from": "2019-12-23", "to": "2024-11-23", "state": 14, "expect": "same" },
    { "case": "merger after the later election does not apply", "prev": "JVM", "cur": "BJP", "from": "2014-12-23", "to": "2019-12-23", "state": 14, "expect": "different" },
    { "case": "split: the name-holder keeps the history", "prev": "SHS", "cur": "SHS", "from": "2019-10-24", "to": "2024-11-23", "state": 20, "expect": "same" },
    { "case": "split: the other faction holding an old-party seat", "prev": "SHS", "cur": "SSUBT", "from": "2019-10-24", "to": "2024-11-23", "state": 20, "expect": "split" },
    { "case": "split: the other faction taking a seat from another party is a flip", "prev": "INC", "cur": "SSUBT", "from": "2019-10-24", "to": "2024-11-23", "state": 20, "expect": "different" },
    { "case": "split with a new-id successor", "prev": "LJP", "cur": "LJPRV", "from": "2020-11-10", "to": "2025-11-14", "state": 5, "expect": "same" },
    { "case": "split: the non-successor faction of LJP", "prev": "LJP", "cur": "RLJP", "from": "2020-11-10", "to": "2025-11-14", "state": 5, "expect": "split" },
    { "case": "a 2014→2019 comparison ignores the 2022 split", "prev": "SHS", "cur": "SSUBT", "from": "2014-10-19", "to": "2019-10-24", "state": 20, "expect": "different" },
    { "case": "a state-scoped split applies in its state", "prev": "KECM", "cur": "KECJ", "from": "2016-05-19", "to": "2021-05-02", "state": 16, "expect": "split" },
    { "case": "a state-scoped split does not leak into another state", "prev": "KECM", "cur": "KECJ", "from": "2016-05-19", "to": "2021-05-02", "state": 31, "expect": "different" },
    { "case": "unrelated parties", "prev": "BJP", "cur": "INC", "from": "2019-10-24", "to": "2024-11-23", "state": 20, "expect": "different" }
  ],
  "carryForward": [
    { "case": "rename", "party": "TRS", "from": "2018-12-11", "to": "2023-12-03", "state": 32, "expect": "BRS" },
    { "case": "merger", "party": "JVM", "from": "2019-12-23", "to": "2024-11-23", "state": 14, "expect": "BJP" },
    { "case": "split, new-id successor", "party": "LJP", "from": "2020-11-10", "to": "2025-11-14", "state": 5, "expect": "LJPRV" },
    { "case": "split, name kept by the successor (no row): unchanged", "party": "SHS", "from": "2019-10-24", "to": "2024-11-23", "state": 20, "expect": "SHS" },
    { "case": "no event between the dates", "party": "TRS", "from": "2014-05-16", "to": "2018-12-11", "state": 32, "expect": "TRS" }
  ],
  "familyOf": [
