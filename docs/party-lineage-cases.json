    { "party_id": "BJP", "predecessor_id": "JVM", "kind": "merger", "effective_date": "2020-02-17", "state_id": null, "is_successor": true },
    { "party_id": "SSUBT", "predecessor_id": "SHS", "kind": "split", "effective_date": "2022-10-10", "state_id": null, "is_successor": false },
    { "party_id": "LJPRV", "predecessor_id": "LJP", "kind": "split", "effective_date": "2021-10-05", "state_id": null, "is_successor": true },
    { "party_id": "RLJP", "predecessor_id": "LJP", "kind": "split", "effective_date": "2021-10-05", "state_id": null, "is_successor": false },
    { "party_id": "KECJ", "predecessor_id": "KECM", "kind": "split", "effective_date": "2020-06-01", "state_id": 16, "is_successor": false }
