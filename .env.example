# Copy to .env and adjust. One set of names is shared by docker-compose, database/setup.sh,
# the backend and the scraper.

# --- Database ---
# Used by docker-compose (Postgres container), database/setup.sh and the scraper.
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=password123
DB_NAME=election_tracker
# Used by the backend (Prisma). Must point at the same database as the DB_* values above.
# (The scraper and setup.sh also honour DATABASE_URL when it is set.)
DATABASE_URL=postgresql://admin:password123@localhost:5432/election_tracker?schema=public
# Direct (non-pooler) connection for Prisma CLI commands that read schema.prisma's
# `directUrl` (prisma validate, prisma migrate diff). The running app and
# `prisma generate` do not need it. Locally it may equal DATABASE_URL; on Neon use
# the direct host, and DATABASE_URL = the pooled URL (…-pooler…?pgbouncer=true&connection_limit=5).
DIRECT_URL=postgresql://admin:password123@localhost:5432/election_tracker?schema=public

# --- Redis ---
# Either a URL (wins when set; rediss:// = TLS, e.g. Upstash
# rediss://default:<token>@<db>.upstash.io:6379) …
REDIS_URL=
# … or host/port (+ optional password) for the local docker Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend ---
PORT=3082
# REQUIRED — the backend refuses to start without it, or when it is shorter than 32 chars
# (HS256 only). Generate e.g. with: openssl rand -hex 32
JWT_SECRET=
# Admin session token lifetime (jsonwebtoken duration such as 8h / 30m, or seconds). Default 8h.
# Logout and a password change revoke tokens earlier (users.token_version, migration 026).
JWT_TTL=8h
# Comma-separated list of allowed browser origins (public SPA + admin SPA). Spaces are trimmed.
CORS_ORIGINS=http://localhost:3080,http://localhost:3081
# Optional extra allowed-origin regex, e.g. Vercel previews: ^https://matdaanpulse-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
# Reverse-proxy hops in front of the backend, used for req.ip (rate limiting). Render: 1.
# Always a number, never "true". Too high lets clients spoof their IP via X-Forwarded-For
# and bypass the login limit. Verify with LOG_LEVEL=debug: the first non-health request
# logs "Client IP check" (see docs/DEPLOYMENT.md §5.3).
TRUST_PROXY_HOPS=1
# Behind Cloudflare: take the client IP from CF-Connecting-IP instead (true/false).
# Only safe when the origin accepts traffic from Cloudflare alone — otherwise anyone
# can send the header and choose their own rate-limit bucket. See DEPLOYMENT.md §5.4.
TRUST_CF_CONNECTING_IP=false
# Origin shield: comma-separated secrets (current first, previous during rotation). When set,
# every request except GET/HEAD /api/v1/health/live must carry X-Origin-Secret with one of them
# (added by a Cloudflare Transform Rule), else 403. Required for TRUST_CF_CONNECTING_IP=true.
ORIGIN_SHARED_SECRETS=
# Per-process cap on open admin Live Console SSE connections (503 beyond it).
SSE_MAX_CONNECTIONS=200
# Per-IP request limits per minute: every route (public) and /auth/* (auth).
# Live SSE and /health/* are never throttled. Public is generous for mobile CGNAT.
THROTTLE_PUBLIC_PER_MIN=600
THROTTLE_AUTH_PER_MIN=5
# Per-IP limit per minute for the public feedback form (POST /feedback), on top of the public limit.
THROTTLE_FEEDBACK_PER_MIN=5
# Salt for feedback IP hashes (sha256(salt + client IP); the raw IP is never stored).
# Set a random value in production (e.g. openssl rand -hex 32); unset falls back to a fixed dev salt.
FEEDBACK_IP_SALT=
# Public self-registration (/auth/register creates VIEWER accounts). Off unless "true".
ALLOW_REGISTRATION=false
# Log level: error | warn | info | debug (debug also logs Prisma queries). Default info.
LOG_LEVEL=info

# Initial SUPER_ADMIN, created/updated by: cd backend && npm run create-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Observability ---
# OpenTelemetry starts only when OTEL_EXPORTER_OTLP_ENDPOINT is set and OTEL_SDK_DISABLED
# is not "true". The backend exports OTLP over HTTP (port 4318 on the docker-compose
# otel-collector; /v1/traces and /v1/metrics are appended). Leave empty to disable.
# For local tracing with the docker-compose collector: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional auth headers for a hosted OTLP backend, e.g. "signoz-ingestion-key=<key>"
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=matdaanpulse-backend
# Set to true to force telemetry off (recommended on Render without a collector).
OTEL_SDK_DISABLED=false
# Used by the otel-collector container to forward to SigNoz Cloud
SIGNOZ_ENDPOINT=ingest.us.signoz.cloud:443
SIGNOZ_INGESTION_KEY=

# --- Scraper / live simulation ---
# Backend base URL used by scraper scripts (replay)
API_BASE_URL=http://localhost:3082/api/v1
# Admin account used by src/simulation/replay.ts (falls back to ADMIN_EMAIL / ADMIN_PASSWORD)
SIM_ADMIN_EMAIL=
SIM_ADMIN_PASSWORD=

# --- Live worker (scraper/src/live, docs/LIVE_RUNBOOK.md) ---
# Ingest API base URL (default http://localhost:3082/api/v1, or apiBaseUrl in live.config.json)
INGEST_API_URL=http://localhost:3082/api/v1
# Machine key (mpk_...) from Admin -> Ingest keys; required by `npm run live` and `live:check`
INGEST_KEY=
# Lease holder name, unique per worker host (default: the hostname). Set it explicitly on every host.
LIVE_HOLDER=
# eci-web adapter: ECI results site base URL when live.config.json has no baseUrl (e.g. https://results.eci.gov.in/ResultAcGenMay2026)
ECI_VS_BASE_URL=

# --- docker-compose DB init ---
# First boot of an empty volume runs database/setup.sh; set to --schema-only to skip seed data.
ET_DB_INIT_ARGS=

# Image hosting (admin uploads + seed photos): S3 bucket, public-read by bucket policy. Unset bucket = uploads return 503.
# The IAM user needs s3:PutObject/GetObject on <bucket>/* and s3:ListBucket on the bucket (docs/DEPLOYMENT.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=matdaanpulse-media
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=https://matdaanpulse-media.s3.ap-south-1.amazonaws.com
# Admin build: public site origin, used to show site-relative images (/symbols/...) in the admin.
VITE_PUBLIC_SITE_URL=http://localhost:3080

# Optional: Slack/Telegram-bridge webhook for live ingest alerts (lag, lapsed lease, rejected seats, refused requests, tally mismatch)
INGEST_ALERT_WEBHOOK_URL=
