{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/geo/jk_ac(_2008)?\\.geojson",
      "destination": "/geo/jk_ac_1995.geojson",
      "permanent": true
    },
    {
      "source": "/geo/([a-z]+_ac|india_pc)\\.geojson",
      "destination": "/geo/$1_2008.geojson",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
