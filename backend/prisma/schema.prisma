generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App traffic. On Neon: the pooled (PgBouncer) URL with pgbouncer=true&connection_limit=5.
  url       = env("DATABASE_URL")
  // Direct (non-pooler) URL, used by Prisma CLI commands that need a session
  // (migrate diff, db pull). Locally it may equal DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   String   @db.VarChar(255)
  old_value   Json?
  new_value   Json?
  timestamp   DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
}

/// person_id is required (migration 018). The DB column is nullable only so the AFTER INSERT trigger can
/// fill it, and a deferred constraint trigger rejects any commit that leaves it NULL. Prisma requires the
/// field on create; only raw SQL inserts (seeds, scraper) may omit it, and the trigger then creates the person.
model candidates {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  person_id      String         @db.Uuid
  election_id    String         @db.Uuid
  const_id       String         @db.VarChar(100)
  party_id       String?        @db.VarChar(20)
  name           String         @db.VarChar(255)
  is_incumbent   Boolean        @default(false)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  /// Affidavit for this run: age at nomination, assets and liabilities in rupees.
  age            Int?           @db.SmallInt
  assets         BigInt?
  liabilities    BigInt?
  criminal_cases Int?           @db.SmallInt
  /// Unused since migration 018 (expand step; a later migration drops it). @ignore keeps it out of the client.
  metadata       Json?          @default("{}") @ignore
  constituencies constituencies @relation(fields: [const_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  elections      elections      @relation(fields: [election_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parties        parties?       @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons        persons        @relation(fields: [person_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  results        results[]

  @@index([const_id], map: "idx_candidates_const_id")
  @@index([election_id, const_id], map: "idx_candidates_election_const")
  @@index([person_id], map: "idx_candidates_person_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model constituencies {
  id                    String                  @id @db.VarChar(100)
  election_id           String                  @db.Uuid
  district_id           Int?
  state_id              Int?
  name                  String                  @db.VarChar(255)
  const_no              Int
  type                  constituency_type       @default(GEN)
  voter_turnout         Decimal?                @db.Decimal(5, 2)
  phase                 Int?                    @db.SmallInt
  total_electors        Int?
  metadata              Json?                   @default("{}")
  region_id             Int?
  current_round         Int?
  total_rounds          Int?
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  candidates            candidates[]
  districts             districts?              @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  elections             elections               @relation(fields: [election_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions               regions?                @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  states                states?                 @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  constituency_analysis constituency_analysis[]
  results               results[]
  seatIngestStates      seat_ingest_state[]
  seatHolds             seat_holds[]

  @@index([election_id], map: "idx_constituencies_election_id")
  @@index([region_id], map: "idx_constituencies_region_id")
  @@index([state_id], map: "idx_constituencies_state_id")
}

model constituency_analysis {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  const_id        String         @db.VarChar(100)
  election_id     String         @db.Uuid
  dominance       String?        @db.VarChar(20)
  dominance_party String?        @db.VarChar(20)
  incumbency      Json?          @default("{}")
  notes           String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  updated_at      DateTime?      @default(now()) @db.Timestamp(6)
  constituencies  constituencies @relation(fields: [const_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  elections       elections      @relation(fields: [election_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([const_id, election_id])
  @@index([const_id], map: "idx_const_analysis_const")
  @@index([election_id], map: "idx_const_analysis_election")
}

model districts {
  id             Int              @id @default(autoincrement())
  state_id       Int
  name           String           @db.VarChar(255)
  code           String           @unique @db.VarChar(50)
  constituencies constituencies[]
  states         states           @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons        persons[]
}

model elections {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @db.VarChar(255)
  type                  election_type
  state_id              Int?
  year                  Int
  status                election_status         @default(Upcoming)
  tentative_next_date   DateTime?               @db.Date
  manifest_url          String?
  manifest_draft        Json?
  /// Boundary set the seats belong to (delimitation order year, e.g. "2008"); NULL compares with nothing (migration 019).
  delimitation          String?                 @db.VarChar(10)
  candidates            candidates[]
  constituencies        constituencies[]
  constituency_analysis constituency_analysis[]
  states                states?                 @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  results               results[]
  election_live_state   election_live_state?
  ingest                election_ingest?
  ingestShards          ingest_shards[]
  seatIngestStates      seat_ingest_state[]
  seatHolds             seat_holds[]
  ingestLogs            ingest_log[]

  @@unique([type, state_id, year], map: "uq_elections_type_state_year")
  @@index([type, year], map: "idx_elections_type_year")
}

/// Monotonic per-election live version, bumped by DB triggers on results/candidates/parties writes (migration 015).
model election_live_state {
  election_id String    @id @db.Uuid
  version     BigInt
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  elections   elections @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Public feedback (migration 016). kind/status/message length are CHECK constraints in SQL.
model feedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  message    String
  email      String?
  page       String?
  status     String   @default("new")
  ip_hash    String?
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, created_at(sort: Desc)], map: "idx_feedback_status_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parties {
  id              String       @id @db.VarChar(20)
  name            String       @db.VarChar(255)
  color           String?      @db.VarChar(10)
  symbol_url      String?
  abbreviation    String?      @db.VarChar(20)
  leader_name     String?      @db.VarChar(255)
  founded_year    Int?
  headquarters    String?      @db.VarChar(255)
  website         String?
  eci_symbol_url  String?
  wikipedia_url   String?
  description     String?
  eci_recognition String?      @db.VarChar(20)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  candidates      candidates[]
  lineage         party_lineage[] @relation("lineage_party")
  successors      party_lineage[] @relation("lineage_predecessor")
  units           party_units[]
}

model persons {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(255)
  photo_url     String?
  gender        String?         @db.VarChar(10)
  education     String?         @db.VarChar(255)
  date_of_birth DateTime?       @db.Date
  state_id      Int?
  region_id     Int?
  district_id   Int?
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  bio           String?
  wikipedia_url String?
  caste         String?
  religion      String?
  /// Unused since migration 018 (expand step; a later migration drops it). @ignore keeps it out of the client.
  metadata      Json?           @default("{}") @ignore
  candidates    candidates[]
  merges        person_merges[]
  party_roles   party_unit_roles[]
  districts     districts?      @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions       regions?        @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  states        states?         @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([district_id], map: "idx_persons_district")
  @@index([region_id], map: "idx_persons_region")
  @@index([state_id], map: "idx_persons_state")
}

model regions {
  id             Int              @id @default(autoincrement())
  state_id       Int
  name           String           @db.VarChar(255)
  code           String           @db.VarChar(50)
  constituencies constituencies[]
  persons        persons[]
  states         states           @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([state_id, code])
  @@index([state_id], map: "idx_regions_state")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model results {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id   String         @db.Uuid
  const_id       String         @db.VarChar(100)
  votes          Int            @default(0)
  status         result_status  @default(TRAILING)
  margin         Int?           @default(0)
  round_no       Int?           @default(0)
  last_updated   DateTime       @default(now()) @db.Timestamp(6)
  election_id    String         @db.Uuid
  elections      elections      @relation(fields: [election_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_results_election")
  candidates     candidates     @relation(fields: [candidate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  constituencies constituencies @relation(fields: [const_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([candidate_id, const_id], map: "uq_results_candidate_const")
  @@index([candidate_id], map: "idx_results_candidate_id")
  @@index([const_id, status], map: "idx_results_const_status")
  @@index([election_id], map: "idx_results_election_id")
  @@index([election_id, status], map: "idx_results_election_status")
  @@index([election_id, votes(sort: Desc)], map: "idx_results_election_votes")
  @@index([const_id, votes(sort: Desc)], map: "idx_results_const_votes")
}

model states {
  id                   Int              @id @default(autoincrement())
  name                 String           @db.VarChar(255)
  code                 String           @unique @db.VarChar(10)
  total_assembly_seats Int              @default(0)
  total_ls_seats       Int              @default(0)
  constituencies       constituencies[]
  districts            districts[]
  elections            elections[]
  persons              persons[]
  regions              regions[]
  party_lineage        party_lineage[]
  party_units          party_units[]
}

model users {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String            @unique @db.VarChar(255)
  password_hash String            @db.VarChar(255)
  role          user_role         @default(VIEWER)
  name          String            @db.VarChar(255)
  created_at    DateTime          @default(now()) @db.Timestamp(6)
  audit_logs    audit_logs[]
  merges_made   person_merges[]   @relation("person_merges_merged_by")
  merges_undone person_merges[]   @relation("person_merges_undone_by")
  ingestUpdates election_ingest[] @relation("election_ingest_updated_by")
  ingestKeys    ingest_keys[]     @relation("ingest_keys_created_by")
  seatHolds     seat_holds[]      @relation("seat_holds_created_by")
}

/// Merge log (migration 018): the duplicate's full row and the candidates that moved, so a merge can be undone once.
/// keeper_id becomes NULL when the keeper is later deleted (merged away); such a merge can no longer be undone.
model person_merges {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keeper_id     String?   @db.Uuid
  duplicate     Json
  candidate_ids String[]  @db.Uuid
  filled_fields Json      @default("{}")
  merged_by     String?   @db.Uuid
  merged_at     DateTime  @default(now()) @db.Timestamptz(6)
  undone_at     DateTime? @db.Timestamptz(6)
  undone_by     String?   @db.Uuid
  /// The original keeper id (no FK): kept when keeper_id is SET NULL; history and undo read it.
  keeper_ref    String    @db.Uuid
  keeper        persons?  @relation(fields: [keeper_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  merger        users?    @relation("person_merges_merged_by", fields: [merged_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  undoer        users?    @relation("person_merges_undone_by", fields: [undone_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([keeper_id], map: "idx_person_merges_keeper")
  @@index([keeper_ref], map: "idx_person_merges_keeper_ref")
}

enum constituency_type {
  GEN
  SC
  ST
}

enum election_status {
  Upcoming
  Live
  Finalized
}

enum election_type {
  LS
  VS
}

enum result_status {
  LEADING
  WON
  TRAILING
  LOST
}

enum user_role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

/// Every non-empty candidates.metadata value, archived by migration 018 before a later migration drops the column.
/// No unique key (an archive, read by hand), so Prisma Client ignores it.
model candidate_metadata_archive {
  candidate_id String   @db.Uuid
  metadata     Json
  archived_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([candidate_id], map: "idx_candidate_metadata_archive_candidate")
  @@ignore
}

/// Every non-empty persons.metadata value, archived by migration 018 before a later migration drops the column.
model person_metadata_archive {
  person_id   String   @db.Uuid
  metadata    Json
  archived_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([person_id], map: "idx_person_metadata_archive_person")
  @@ignore
}

/// Run-once markers (migration 018): a seed or one-off data step that must not be re-applied over admin
/// edits records its name here; setup.sh re-runs every file, and the file skips itself when its row exists.
model seed_runs {
  name   String    @id
  ran_at DateTime? @default(now()) @db.Timestamptz(6)

  @@ignore
}

model election_ingest {
  election_id           String       @id @db.Uuid
  active_source         String?
  hold_minutes          Int          @default(10)
  updated_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_by            String?      @db.Uuid
  rest_source_override  String?
  rest_lease_holder     String?
  rest_lease_key_id     String?      @db.Uuid
  rest_lease_expires_at DateTime?    @db.Timestamptz(6)
  elections             elections    @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingest_keys           ingest_keys? @relation(fields: [rest_lease_key_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updater               users?       @relation("election_ingest_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model ingest_keys {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String            @unique @db.VarChar(80)
  key_hash           String            @unique @db.Char(64)
  created_by         String?           @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  last_used_at       DateTime?         @db.Timestamptz(6)
  revoked_at         DateTime?         @db.Timestamptz(6)
  creator            users?            @relation("ingest_keys_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  electionRestLeases election_ingest[]
  shardLeases        ingest_shards[]
  logs               ingest_log[]
}

model ingest_shards {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id      String       @db.Uuid
  name             String       @db.VarChar(40)
  source_override  String?
  selector         Json
  lease_holder     String?
  lease_key_id     String?      @db.Uuid
  lease_expires_at DateTime?    @db.Timestamptz(6)
  elections        elections    @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingest_keys      ingest_keys? @relation(fields: [lease_key_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([election_id, name])
}

model seat_ingest_state {
  election_id          String         @db.Uuid
  const_id             String         @db.VarChar(100)
  state                String?
  round_current        Int?
  round_total          Int?
  last_source          String?
  last_observed_at     DateTime?      @db.Timestamptz(6)
  last_applied_at      DateTime?      @db.Timestamptz(6)
  last_rejected_reason String?
  last_rejected_at     DateTime?      @db.Timestamptz(6)
  elections            elections      @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  constituencies       constituencies @relation(fields: [const_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([election_id, const_id])
}

model seat_holds {
  election_id    String         @db.Uuid
  const_id       String         @db.VarChar(100)
  round_at_hold  Int?
  expires_at     DateTime       @db.Timestamptz(6)
  created_by     String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  elections      elections      @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  holder         users?         @relation("seat_holds_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  constituencies constituencies @relation(fields: [const_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([election_id, const_id])
}

model ingest_log {
  id             BigInt       @id @default(autoincrement())
  election_id    String       @db.Uuid
  shard          String       @db.VarChar(40)
  key_id         String?      @db.Uuid
  source         String
  dry_run        Boolean      @default(false)
  kind           String       @default("seats")
  received_at    DateTime     @default(now()) @db.Timestamptz(6)
  observed_at    DateTime?    @db.Timestamptz(6)
  counts         Json         @default("{}")
  rejected       Json         @default("[]")
  tally_mismatch Json?
  refused        String?
  elections      elections    @relation(fields: [election_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingest_keys    ingest_keys? @relation(fields: [key_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([election_id, received_at(sort: Desc)], map: "ingest_log_election_received")
}

model image_credits {
  url        String   @id
  source_url String
  author     String?
  licence    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Migration 023: a party came from a predecessor by rename, merger or split (state_id: only in that state's comparisons).
model party_lineage {
  id             Int       @id @default(autoincrement())
  party_id       String    @db.VarChar(20)
  predecessor_id String    @db.VarChar(20)
  kind           String    @db.VarChar(10)
  effective_date DateTime  @db.Date
  state_id       Int?
  is_successor   Boolean   @default(false)
  note           String?
  source_url     String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  party          parties   @relation("lineage_party", fields: [party_id], references: [id], onUpdate: Cascade, onDelete: NoAction)
  predecessor    parties   @relation("lineage_predecessor", fields: [predecessor_id], references: [id], onUpdate: Cascade, onDelete: NoAction)
  states         states?   @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([predecessor_id], map: "idx_party_lineage_predecessor")
}

/// Migration 023: a party's unit in one state (recognition there, office).
model party_units {
  party_id        String             @db.VarChar(20)
  state_id        Int
  eci_recognition String?            @db.VarChar(20)
  office          String?            @db.VarChar(255)
  website         String?
  updated_at      DateTime           @default(now()) @db.Timestamptz(6)
  parties         parties            @relation(fields: [party_id], references: [id], onUpdate: Cascade, onDelete: NoAction)
  states          states             @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles           party_unit_roles[]

  @@id([party_id, state_id])
}

/// Migration 023: who held a unit role (state_president | legislature_leader) and when; current = to_date null.
model party_unit_roles {
  id          Int         @id @default(autoincrement())
  party_id    String      @db.VarChar(20)
  state_id    Int
  role        String      @db.VarChar(30)
  person_id   String?     @db.Uuid
  person_name String      @db.VarChar(255)
  from_date   DateTime?   @db.Date
  to_date     DateTime?   @db.Date
  source_url  String?
  unit        party_units @relation(fields: [party_id, state_id], references: [party_id, state_id], onDelete: Cascade, onUpdate: Cascade)
  persons     persons?    @relation(fields: [person_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([person_id], map: "idx_party_unit_roles_person")
}
